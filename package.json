{
  "name": "DSP Recipe Calculator",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm exec tsx scripts/generate-build-info.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --ui --coverage",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=edge",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --project=firefox --project=edge --ui",
    "test:e2e:debug": "playwright test --project=chromium --project=firefox --project=edge --debug",
    "convert:webp": "tsx scripts/convert-to-webp.ts",
    "generate:recipe-sids": "node scripts/generate-recipe-sids.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-form": "^0.1.12",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "d3-sankey": "^0.12.3",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.1",
    "js-cookie": "^3.0.8",
    "lz-string": "^1.5.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/dompurify": "^3.2.0",
    "@types/html2canvas": "^1.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.15",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "spritesmith": "^3.5.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
