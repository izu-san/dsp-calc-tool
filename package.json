{
  "name": "DSP Recipe Calculator",
  "version": "0.0.4",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm exec tsx scripts/generate-build-info.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --ui --coverage",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=edge",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --project=firefox --project=edge --ui",
    "test:e2e:debug": "playwright test --project=chromium --project=firefox --project=edge --debug",
    "convert:webp": "tsx scripts/convert-to-webp.ts",
    "generate:recipe-sids": "node scripts/generate-recipe-sids.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-form": "^0.1.8",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "d3-sankey": "^0.12.3",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.3.1",
    "fast-xml-parser": "^5.3.3",
    "html2canvas": "^1.4.1",
    "i18next": "^25.7.4",
    "js-cookie": "^3.0.5",
    "lz-string": "^1.5.0",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.1",
    "react-markdown": "^10.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/html2canvas": "^1.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "happy-dom": "^20.3.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
